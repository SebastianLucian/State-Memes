# Solana cluster used for wallet balance lookups: mainnet-beta | devnet | testnet
VITE_SOLANA_CLUSTER=devnet
# Optional custom RPC endpoint (overrides the cluster default)
VITE_SOLANA_RPC=

# Supabase (optional). Without these the app runs on built-in mock data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# List the no-funds Preview Wallet in production builds (always on in dev)
VITE_ENABLE_DEMO_WALLET=
